{
  "name": "purifier-radar",
  "version": "2.0.0",
  "description": "PuriFier - AI-Powered Pre-Connection Wireless Threat Intelligence Agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.purifier.radar",
    "productName": "PuriFier Radar",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/purifier_backend",
        "to": "dist/purifier_backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "evil-twin",
    "pre-connection",
    "wireless-security",
    "gemastik",
    "purifier",
    "onnx-ai"
  ],
  "author": "PuriFier Team - GEMASTIK Software Development",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
